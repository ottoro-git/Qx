# Amazon
# --- Amazon 购物极简 ---
# 主站 (涵盖美亚、日亚、德亚等)
host-keyword, amazon, Amazon

# 图片与静态资源 (必须加，否则图片刷不出)
host-suffix, ssl-images-amazon.com, Amazon
host-suffix, media-amazon.com, Amazon
host-suffix, images-amazon.com, Amazon

# 排除国内 (如果你还需要访问亚马逊中国/AWS CN，可以把下面这行放前面并设为 direct)
# host-suffix, amazon.cn, direct

# --- Audible 极简规则 ---
# 核心服务与短链
host-keyword, audible, Amazon
host-suffix, adbl.co, Amazon

# 静态资源与 CDN (下载书和封面)
host-suffix, audiblecdn.com, Amazon
host-suffix, audible-assets.com, Amazon

# 避免误判的各地区域名 (覆盖 .com, .co.uk, .co.jp, .de 等)
host-suffix, audible.com, Amazon
host-suffix, audible.co.uk, Amazon
host-suffix, audible.co.jp, Amazon
host-suffix, audible.de, Amazon
host-suffix, audible.fr, Amazon
host-suffix, audible.it, Amazon
host-suffix, audible.ca, Amazon
host-suffix, audible.com.au, Amazon